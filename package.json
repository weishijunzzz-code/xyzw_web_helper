{
  "name": "xyzw-token-manager",
  "version": "2.0.0",
  "type": "module",
  "description": "XYZW游戏Token管理器 - 支持Base64导入和WebSocket连接管理",
  "main": "src/main.js",
  "scripts": {
    "testr": "node ./test/roleToken.js",
    "testd": "node ./test/token.js",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext .vue,.js,.ts --fix",
    "format": "prettier --write \"src/**/*.{js,vue,ts,css,scss}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "docs:generate": "typedoc --out docs src",
    "docs:serve": "typedoc --out docs src && npx serve docs",
    "cap:init": "npx cap init",
    "cap:add:android": "npx cap add android",
    "cap:add:ios": "npx cap add ios",
    "cap:sync": "npx cap sync",
    "cap:sync:android": "npx cap sync android",
    "cap:sync:ios": "npx cap sync ios",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "cap:copy": "npx cap copy",
    "cap:run:android": "npx cap run android",
    "cap:run:ios": "npx cap run ios",
    "build:android": "vite build && npx cap sync android",
    "build:ios": "vite build && npx cap sync ios"
  },
  "dependencies": {
    "@arco-design/web-vue": "^2.57.0",
    "@capacitor-community/http": "^1.4.1",
    "@capacitor/android": "^8.3.0",
    "@capacitor/app": "^8.1.0",
    "@capacitor/browser": "^8.0.3",
    "@capacitor/cli": "^8.3.0",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.3.0",
    "@capacitor/device": "^8.0.2",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/haptics": "^8.0.1",
    "@capacitor/keyboard": "^8.0.2",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@capacitor/toast": "^8.0.1",
    "@vicons/ionicons5": "^0.12.0",
    "@vicons/material": "^0.12.0",
    "@vueuse/core": "^13.9.0",
    "axios": "^1.12.2",
    "crypto-js": "^4.2.0",
    "echarts": "^6.0.0",
    "event-emitter3": "^1.0.4",
    "html2canvas": "^1.4.1",
    "idb": "^8.0.3",
    "naive-ui": "^2.43.1",
    "p-queue": "^7.4.1",
    "pinia": "^2.3.1",
    "vue": "^3.5.22",
    "vue-echarts": "^8.0.1",
    "vue-i18n": "^11.1.12",
    "vue-router": "^4.6.3",
    "vuedraggable": "^4.1.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^6.7.3",
    "@iconify-json/mdi": "^1.2.3",
    "@intlify/unplugin-vue-i18n": "^6.0.8",
    "@playwright/test": "^1.40.0",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^20.19.21",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitest/coverage-v8": "^1.0.0",
    "@vue/test-utils": "^2.4.0",
    "@vue/tsconfig": "^0.8.1",
    "jiti": "^2.6.1",
    "jsdom": "^23.0.0",
    "lz4js": "^0.2.0",
    "sass": "^1.93.2",
    "serve": "^14.2.0",
    "typedoc": "^0.25.0",
    "typescript": "^5.9.3",
    "unocss": "^0.61.9",
    "unplugin-auto-import": "^19.3.0",
    "unplugin-vue-components": "^28.4.1",
    "unplugin-vue-router": "^0.8.8",
    "vite": "^5.4.11",
    "vitest": "^1.0.0"
  },
  "keywords": [
    "vue",
    "token-management",
    "websocket",
    "base64",
    "game-automation",
    "xyzw",
    "frontend"
  ],
  "author": "XYZW Team",
  "license": "CC-BY-NC-SA-4.0",
  "packageManager": "pnpm@10.19.0"
}
